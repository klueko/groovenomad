{
  "expo": {
    "name": "FestiFun",
    "slug": "festifun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EFFD"
    },
    "assetBundlePatterns": ["**/*"],
    "fonts": [
      "./assets/fonts/Poppins-Regular.ttf",
      "./assets/fonts/Poppins-Medium.ttf",
      "./assets/fonts/Poppins-SemiBold.ttf",
      "./assets/fonts/Poppins-Bold.ttf",
      "./assets/fonts/FasterOne-Regular.ttf"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hugodorus.festifun"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#F5EFFD"
      },
      "package": "com.hugodorus.festifun",
      "allowBackup": false,
      "enableProguardInReleaseBuilds": false
    },
    "web": {
      "favicon": "./app/assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-font"
    ],
    "scheme": "festifun",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "betterAuthUrl": "http://10.186.166.166:8081",
      "eas": {
        "projectId": "05a3ff07-4480-45c9-9f97-6bc3a9f29e0f"
      }
    },
    "owner": "hugodorus"
  }
}
