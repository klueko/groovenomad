{
  "expo": {
    "name": "FestiFun",
    "slug": "festifun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hugodorus.groovenomad"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.hugodorus.groovenomad"
    },
    "web": {
      "favicon": "./app/assets/favicon.png",
      "output": "server"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-dev-client"],
    "scheme": "groovenomad",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "betterAuthUrl": "http://10.186.166.166:8081",
      "eas": {
        "projectId": "05a3ff07-4480-45c9-9f97-6bc3a9f29e0f"
      }
    },
    "owner": "hugodorus"
  }
}
